VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# --- Captcha (OPCIONAL; ver README, sección "Captcha") ---
# Déjelo vacío para trabajar sin captcha. La clave del sitio es pública; los secretos van SOLO en Vercel, nunca aquí.
# Para probar EN SU COMPUTADOR, Cloudflare ofrece la clave de sitio 1x00000000000000000000AA (siempre pasa).
# NUNCA use las claves de prueba (las que empiezan por 1x, 2x o 3x) en producción: dejarían la API sin captcha real.
VITE_TURNSTILE_SITE_KEY=

